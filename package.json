{
  "name": "droply",
  "version": "2.8.3",
  "description": "Droply",
  "main": "main.js",
  "author": "Droply",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "prestart": "node scripts/check-config.js",
    "test": "node scripts/run-tests.js",
    "check-config": "node scripts/check-config.js",
    "predist": "node scripts/check-config.js",
    "dist": "electron-builder --publish never",
    "server:start": "npm --prefix server start",
    "server:test": "npm --prefix server test"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.droply.app",
    "productName": "Droply",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "config.js",
      "updater.js",
      "desktop.js",
      "settings.js",
      "settings.css",
      "access.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "shortcutName": "Droply",
      "uninstallDisplayName": "Droply",
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png"
    },
    "dmg": {
      "title": "Droply"
    },
    "linux": {
      "target": "AppImage"
    },
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "waterme1on7r-byte",
        "repo": "Droply",
        "releaseType": "draft"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.6.2",
    "ws": "8.23.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/waterme1on7r-byte/Droply.git"
  }
}
